{
	"name": "terminal-rspec",
	"displayName": "terminal-rspec",
	"repository": {
		"type": "git",
		"url": "https://github.com/tejanium/vscode-terminal-rspec"
	},
	"publisher": "tejanium",
	"description": "Run rspec for the current file or line in iTerm2 or cmux",
	"version": "0.2.1",
	"engines": {
		"vscode": "^1.55.0"
	},
	"categories": [
		"Other"
	],
	"activationEvents": [
		"onCommand:terminal-rspec.runAll",
		"onCommand:terminal-rspec.runAgain",
		"onCommand:terminal-rspec.runCurrent"
	],
	"main": "./extension.js",
	"contributes": {
		"configuration": [
			{
				"title": "General",
				"order": 1,
				"properties": {
					"terminal-rspec.terminal": {
						"type": "string",
						"enum": [
							"iterm",
							"cmux"
						],
						"enumDescriptions": [
							"iTerm2, current session of the first window",
							"cmux, the surface in terminal-rspec.cmuxSurface"
						],
						"default": "iterm",
						"description": "Terminal that runs rspec."
					},
					"terminal-rspec.rspecCommand": {
						"type": "string",
						"default": "bundle exec rspec",
						"description": "Rspec command to use, default: `bundle exec rspec`"
					}
				}
			},
			{
				"title": "iTerm",
				"order": 2,
				"properties": {
					"terminal-rspec.runInForeground": {
						"type": "boolean",
						"default": false,
						"description": "Activate the iTerm session on execution."
					}
				}
			},
			{
				"title": "cmux",
				"order": 3,
				"properties": {
					"terminal-rspec.cmuxSurface": {
						"type": "string",
						"default": "",
						"markdownDescription": "Surface that runs rspec, as a ref (`surface:3`) or UUID. Run `cmux identify` in that pane and copy `caller.surface_ref`."
					},
					"terminal-rspec.cmuxPath": {
						"type": "string",
						"default": "/Applications/cmux.app/Contents/Resources/bin/cmux",
						"description": "Path to the cmux CLI."
					}
				}
			}
		],
		"commands": [
			{
				"command": "terminal-rspec.runAll",
				"title": "terminal-rspec: Run all"
			},
			{
				"command": "terminal-rspec.runAgain",
				"title": "terminal-rspec: Run again"
			},
			{
				"command": "terminal-rspec.runCurrent",
				"title": "terminal-rspec: Run current line"
			}
		]
	},
	"scripts": {
		"test": "node ./test/runTest.js"
	},
	"devDependencies": {
		"@types/glob": "^7.1.3",
		"@types/vscode": "^1.55.0",
		"glob": "^7.1.4",
		"vscode-test": "^1.5.2"
	}
}
